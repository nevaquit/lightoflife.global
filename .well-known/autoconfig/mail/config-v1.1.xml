<?xml version="1.0" encoding="UTF-8"?>
<clientConfig version="1.1">
    <emailProvider id="lightoflife.global">
        <domain>lightoflife.global</domain>
        <displayName>rutendo</displayName>
        <displayShortName>rutendo</displayShortName>

        <incomingServer type="imap">
            <hostname>mail.lightoflife.global</hostname>
            <port>993</port>
            <socketType>SSL</socketType>
            <authentication>password-cleartext</authentication>
            <username>%EMAILADDRESS%</username>
        </incomingServer>

        <outgoingServer type="smtp">
            <hostname>mail.lightoflife.global</hostname>
            <port>465</port>
            <socketType>SSL</socketType>
            <authentication>password-cleartext</authentication>
            <username>%EMAILADDRESS%</username>
        </outgoingServer>
    </emailProvider>
</clientConfig>
