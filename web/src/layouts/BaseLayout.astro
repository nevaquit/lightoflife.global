---
import BaseLayout from '../layouts/BaseLayout.astro'
import SiteFooter from '../components/SiteFooter.astro'
import SiteNav from '../components/SiteNav.astro'
import { site } from '../lib/site'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Light of Life Global',
  description = 'Inspiring faith, hope, and transformation through the Word of God.',
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192x192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 border-b border-oatmeal-dark/50 bg-cream/95 backdrop-blur-sm">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
        <a href="/" class="flex shrink-0 items-center">
          <img
            src="/images/logo.png"
            alt="Light of Life Global"
            width="175"
            height="55"
            class="h-11 w-auto max-w-[175px] object-contain"
          />
        </a>
        <SiteNav items={site.navigation} />
        <a href="/causes" class="btn-primary hidden text-xs lg:inline-flex">Give</a>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
