---
interface Props {
  title?: string
  description?: string
}

const {
  title = 'Light of Life Global',
  description = 'Inspiring faith, hope, and transformation through the Word of God.',
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 border-b border-oatmeal-dark/50 bg-cream/95 backdrop-blur-sm">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
        <a href="/" class="font-serif text-2xl font-semibold text-espresso">
          Light of Life
        </a>
        <ul class="hidden items-center gap-8 md:flex">
          <li><a href="/sermons" class="text-sm font-medium uppercase tracking-wider text-charcoal hover:text-terracotta">Sermons</a></li>
          <li><a href="/devotionals" class="text-sm font-medium uppercase tracking-wider text-charcoal hover:text-terracotta">Devotionals</a></li>
          <li><a href="/causes" class="text-sm font-medium uppercase tracking-wider text-charcoal hover:text-terracotta">Causes</a></li>
        </ul>
        <a href="/causes" class="btn-primary hidden text-xs md:inline-flex">Give</a>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-oatmeal-dark/50 bg-oatmeal">
      <div class="mx-auto max-w-7xl px-6 py-12">
        <div class="flex flex-col items-center justify-between gap-6 md:flex-row">
          <p class="font-serif text-xl text-espresso">Light of Life Global</p>
          <p class="text-sm text-stone">&copy; {new Date().getFullYear()} Light of Life Global. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
