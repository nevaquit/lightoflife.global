---
import BaseLayout from '../../layouts/BaseLayout.astro'
import DevotionalList from '../../components/DevotionalList.astro'
import PageHero from '../../components/PageHero.astro'
import { getDevotionals } from '../../lib/payload'

const devotionals = (await getDevotionals(50)).filter((item) => item.type === 'prayer')
---

<BaseLayout title="Prayers — Light of Life Global" description="Prayers for healing, hope, and illumination.">
  <PageHero title="Prayers" subtitle="Lifting up the world in faith and intercession." />
  <section class="bg-cream py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-6">
      <DevotionalList devotionals={devotionals} emptyMessage="No prayers published yet." />
    </div>
  </section>
</BaseLayout>
