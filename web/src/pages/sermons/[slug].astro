---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ContentImage from '../../components/ContentImage.astro'
import { getSermonBySlug, getSermonImage } from '../../lib/payload'
import { lexicalToHtml } from '../../lib/lexical'
import { CMS_BASE_URL } from '../../lib/payload'

const { slug } = Astro.params
const sermon = slug ? await getSermonBySlug(slug) : null

if (!sermon) {
  return Astro.redirect('/sermons')
}

const thumbUrl = getSermonImage(sermon)
const bodyHtml = lexicalToHtml(sermon.content, CMS_BASE_URL)
---

<BaseLayout title={`${sermon.title} — Light of Life Global`}>
  <article class="bg-cream">
    <section class="bg-oatmeal py-16">
      <div class="mx-auto max-w-4xl px-6">
        <p class="text-sm font-semibold uppercase tracking-wider text-terracotta">{sermon.speaker}</p>
        <h1 class="mt-2 font-serif text-4xl font-medium text-espresso md:text-5xl">{sermon.title}</h1>
        <time class="mt-4 block text-stone" datetime={sermon.publishDate}>
          {new Date(sermon.publishDate).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
      </div>
    </section>

    <section class="mx-auto max-w-4xl px-6 py-12">
      {thumbUrl && (
        <div class="mx-auto mb-10 max-w-lg overflow-hidden rounded-2xl shadow-md">
          <ContentImage src={thumbUrl} alt={sermon.title} variant="sermon" />
        </div>
      )}

      {sermon.videoUrl && (
        <div class="mb-10 aspect-video overflow-hidden rounded-2xl bg-oatmeal-dark">
          <iframe
            src={sermon.videoUrl}
            title={sermon.title}
            class="h-full w-full"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          />
        </div>
      )}

      {sermon.audioUrl && (
        <div class="rounded-2xl bg-oatmeal p-6">
          <p class="mb-4 text-sm font-semibold uppercase tracking-wider text-terracotta">Listen</p>
          <audio controls class="w-full" src={sermon.audioUrl}>
            Your browser does not support the audio element.
          </audio>
        </div>
      )}

      {bodyHtml && (
        <div class="prose prose-lg mt-10 max-w-none text-charcoal">
          <Fragment set:html={bodyHtml} />
        </div>
      )}
    </section>
  </article>
</BaseLayout>
