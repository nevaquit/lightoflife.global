---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getDevotionals } from '../lib/payload'

const devotionals = await getDevotionals()
---

<BaseLayout title="Devotionals — Light of Life Global" description="Daily devotionals to strengthen your walk with God.">
  <section class="bg-oatmeal py-16">
    <div class="mx-auto max-w-7xl px-6">
      <h1 class="section-title">Devotionals</h1>
      <p class="section-subtitle">Daily readings to nourish your spirit.</p>
    </div>
  </section>

  <section class="bg-cream py-16">
    <div class="mx-auto max-w-3xl px-6">
      <div class="space-y-6">
        {
          devotionals.map((devotional) => (
            <a
              href={`/devotionals/${devotional.slug}`}
              class="card block p-6 transition-colors hover:bg-blush-light/30"
            >
              <h2 class="font-serif text-xl text-espresso">{devotional.title}</h2>
              {devotional.scriptureReference && (
                <p class="mt-1 text-sm font-medium text-terracotta">{devotional.scriptureReference}</p>
              )}
              <time class="mt-3 block text-sm text-stone" datetime={devotional.publishDate}>
                {new Date(devotional.publishDate).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
            </a>
          ))
        }
      </div>
      {devotionals.length === 0 && (
        <p class="text-center text-stone">No devotionals published yet.</p>
      )}
    </div>
  </section>
</BaseLayout>
