---
import BaseLayout from '../../layouts/BaseLayout.astro'
import DevotionalList from '../../components/DevotionalList.astro'
import { getDevotionals } from '../../lib/payload'

const devotionals = await getDevotionals()
---

<BaseLayout title="Devotionals — Light of Life Global" description="Daily devotionals to strengthen your walk with God.">
  <section class="bg-oatmeal py-16">
    <div class="mx-auto max-w-7xl px-6">
      <h1 class="section-title">Devotionals</h1>
      <p class="section-subtitle">Daily readings to nourish your spirit.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/devotionals" class="rounded-full bg-terracotta px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-cream">
          All
        </a>
        <a href="/blog" class="rounded-full bg-oatmeal-dark px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-charcoal hover:bg-blush-light">
          Bulletins
        </a>
        <a href="/prayers" class="rounded-full bg-oatmeal-dark px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-charcoal hover:bg-blush-light">
          Prayers
        </a>
      </div>
    </div>
  </section>

  <section class="bg-cream py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-6">
      <DevotionalList devotionals={devotionals} showFeatured={false} />
    </div>
  </section>
</BaseLayout>
