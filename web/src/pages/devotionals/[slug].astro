---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ArticleHeader from '../../components/ArticleHeader.astro'
import ArticleProse from '../../components/ArticleProse.astro'
import { getDevotionalBySlug } from '../../lib/payload'
import { lexicalToHtml } from '../../lib/lexical'

const { slug } = Astro.params
const devotional = slug ? await getDevotionalBySlug(slug) : null

if (!devotional) {
  return Astro.redirect('/devotionals')
}

const bodyHtml = lexicalToHtml(devotional.content)
const backHref = devotional.type === 'prayer' ? '/prayers' : devotional.type === 'bulletin' ? '/blog' : '/devotionals'
const backLabel =
  devotional.type === 'prayer' ? 'Back to Prayers' : devotional.type === 'bulletin' ? 'Back to Blog' : 'Back to Bulletins'
---

<BaseLayout title={`${devotional.title} — Light of Life Global`}>
  <article class="bg-cream pb-20">
    <ArticleHeader devotional={devotional} backHref={backHref} backLabel={backLabel} />

    <div class="mx-auto max-w-3xl px-6">
      <div class="rounded-2xl border border-oatmeal-dark/40 bg-cream px-6 py-10 shadow-sm md:px-10 md:py-14">
        <ArticleProse html={bodyHtml} />
      </div>

      <footer class="mt-12 flex flex-col items-center gap-4 border-t border-oatmeal-dark/40 pt-10 text-center">
        <p class="font-serif text-lg text-espresso">Continue reading</p>
        <a href={backHref} class="btn-secondary">
          {backLabel}
        </a>
      </footer>
    </div>
  </article>
</BaseLayout>
