---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ContentImage from '../../components/ContentImage.astro'
import { getCauses, getCauseImage } from '../../lib/payload'

const causes = await getCauses()
---

<BaseLayout title="Causes — Light of Life Global" description="Support our mission and make a difference.">
  <section class="bg-oatmeal py-16">
    <div class="mx-auto max-w-7xl px-6">
      <h1 class="section-title">Our Causes</h1>
      <p class="section-subtitle">Join us in making an eternal impact.</p>
    </div>
  </section>

  <section class="bg-cream py-16">
    <div class="mx-auto max-w-7xl px-6">
      <div class="grid gap-8 md:grid-cols-2">
        {
          causes.map((cause) => {
            const imgUrl = getCauseImage(cause)
            const progress = Math.min(100, Math.round((cause.currentRaised / cause.donationGoal) * 100))
            return (
              <a href={`/causes/${cause.slug}`} class="card group overflow-hidden">
                <ContentImage src={imgUrl} alt={cause.title} variant="landscape" />
                <div class="p-6">
                  <h2 class="font-serif text-2xl text-espresso">{cause.title}</h2>
                  <div class="mt-4">
                    <div class="h-2.5 overflow-hidden rounded-full bg-oatmeal-dark">
                      <div
                        class="h-full rounded-full bg-terracotta"
                        style={`width: ${progress}%`}
                      />
                    </div>
                    <p class="mt-2 text-sm text-stone">
                      ${cause.currentRaised.toLocaleString()} of ${cause.donationGoal.toLocaleString()} raised
                    </p>
                  </div>
                </div>
              </a>
            )
          })
        }
      </div>
      {causes.length === 0 && (
        <p class="text-center text-stone">No causes published yet.</p>
      )}
    </div>
  </section>
</BaseLayout>
