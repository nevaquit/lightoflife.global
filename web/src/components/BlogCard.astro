---
import type { Devotional } from '../lib/payload'
import { getDevotionalImage } from '../lib/payload'
import { lexicalExcerpt } from '../lib/lexical'
import ContentImage from './ContentImage.astro'

interface Props {
  devotional: Devotional
  featured?: boolean
}

const { devotional, featured = false } = Astro.props
const imgUrl = getDevotionalImage(devotional)
const excerpt = lexicalExcerpt(devotional.content, featured ? 220 : 140)
const date = new Date(devotional.publishDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
---

<a
  href={`/devotionals/${devotional.slug}`}
  class:list={[
    'group flex overflow-hidden rounded-2xl border border-oatmeal-dark/40 bg-cream shadow-sm transition-all hover:-translate-y-0.5 hover:border-terracotta/30 hover:shadow-lg',
    featured ? 'flex-col lg:flex-row' : 'flex-col',
  ]}
>
  <div class:list={[featured ? 'lg:w-3/5' : 'w-full']}>
    <ContentImage
      src={imgUrl}
      alt={devotional.title}
      variant="graphic"
      class={featured ? '!aspect-[16/9] lg:!aspect-auto lg:min-h-[320px]' : ''}
    />
  </div>
  <div
    class:list={[
      'flex flex-1 flex-col justify-center p-6 md:p-8',
      featured ? 'lg:w-2/5' : '',
    ]}
  >
    <div class="flex flex-wrap items-center gap-2">
      <span class="rounded-full bg-blush-light px-3 py-0.5 text-xs font-semibold uppercase tracking-wider text-terracotta">
        {devotional.type === 'bulletin' ? 'Bulletin' : devotional.type ?? 'Article'}
      </span>
      <time class="text-xs text-stone" datetime={devotional.publishDate}>{date}</time>
    </div>
    {devotional.scriptureReference && (
      <p class="mt-3 text-sm font-medium text-terracotta">{devotional.scriptureReference}</p>
    )}
    <h2
      class:list={[
        'mt-2 font-serif text-espresso group-hover:text-terracotta',
        featured ? 'text-2xl md:text-3xl' : 'text-xl',
      ]}
    >
      {devotional.title}
    </h2>
    {excerpt && <p class="mt-4 line-clamp-3 text-sm leading-relaxed text-stone md:text-base">{excerpt}</p>}
    <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold uppercase tracking-wider text-terracotta">
      Read article <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
    </span>
  </div>
</a>
