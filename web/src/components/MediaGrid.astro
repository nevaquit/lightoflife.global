---
import type { HomepageBlock } from '../lib/payload'
import { getMediaUrl } from '../lib/payload'

interface Props {
  block: Extract<HomepageBlock, { blockType: 'mediaGrid' }>
}

const { block } = Astro.props
---

<section class="bg-cream py-20">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-12 text-center">
      <h2 class="section-title">{block.title}</h2>
      {block.subtitle && <p class="section-subtitle">{block.subtitle}</p>}
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {
        block.items.map((item) => {
          const imgUrl = getMediaUrl(typeof item.image === 'object' ? item.image : undefined)
          const href = item.url || '#'
          return (
            <a href={href} class="card group">
              <div class="aspect-[4/3] overflow-hidden bg-oatmeal-dark">
                {imgUrl && (
                  <img
                    src={imgUrl}
                    alt={item.title}
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    loading="lazy"
                  />
                )}
              </div>
              <div class="p-5">
                <span class="text-xs font-semibold uppercase tracking-wider text-terracotta">
                  {item.contentType}
                </span>
                <h3 class="mt-1 font-serif text-lg text-espresso">{item.title}</h3>
              </div>
            </a>
          )
        })
      }
    </div>
  </div>
</section>
