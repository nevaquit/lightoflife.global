---
import type { HomepageBlock } from '../lib/payload'
import { getMediaUrl } from '../lib/payload'
import { site } from '../lib/site'
import ContentImage from './ContentImage.astro'

interface Props {
  block: Extract<HomepageBlock, { blockType: 'mediaGrid' }>
}

const { block } = Astro.props
const pillarImages = site.pillarImages
---

<section class="bg-cream py-20">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-12 text-center">
      <h2 class="section-title">{block.title}</h2>
      {block.subtitle && <p class="section-subtitle">{block.subtitle}</p>}
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        block.items.map((item) => {
          const cmsUrl = getMediaUrl(typeof item.image === 'object' ? item.image : undefined)
          const fallbackUrl =
            item.contentType === 'devotional'
              ? pillarImages.devotional
              : item.contentType === 'sermon'
                ? pillarImages.sermon
                : item.contentType === 'cause'
                  ? pillarImages.cause
                  : undefined
          const imgUrl = cmsUrl || fallbackUrl
          const href = item.url || '#'
          const sermonPillarCrop = 'origin-top object-top scale-[1.5]'
          const imgVariant =
            item.contentType === 'sermon'
              ? 'card'
              : item.contentType === 'cause'
                ? 'card'
                : 'graphic'

          return (
            <a href={href} class="card group">
              <ContentImage
                src={imgUrl}
                alt={item.title}
                variant={imgVariant}
                imageClass={item.contentType === 'sermon' ? sermonPillarCrop : ''}
              />
              <div class="p-5">
                <span class="text-xs font-semibold uppercase tracking-wider text-terracotta">
                  {item.contentType}
                </span>
                <h3 class="mt-1 font-serif text-lg text-espresso">{item.title}</h3>
              </div>
            </a>
          )
        })
      }
    </div>
  </div>
</section>
